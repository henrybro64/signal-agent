[Unit]
Description=signal-agent stock_watchlist via Docker Compose
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Placeholders replaced by deploy/ubuntu/install-systemd.sh
User=__DEPLOY_USER__
Group=__DEPLOY_GROUP__
WorkingDirectory=__SIGNAL_AGENT_HOME__
ExecStart=__SIGNAL_AGENT_HOME__/deploy/ubuntu/run-stock-watchlist.sh
StandardOutput=append:__SIGNAL_AGENT_HOME__/logs/stock_watchlist.log
StandardError=append:__SIGNAL_AGENT_HOME__/logs/stock_watchlist.log
